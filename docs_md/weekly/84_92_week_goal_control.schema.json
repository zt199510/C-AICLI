      "type": "string",
      "format": "date-time"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "checkpoint": {
      "enum": [
        "W84",
        "W85",
        "W86",
        "W87",
        "W88",
        "W89",
        "W90",
        "W91",
        "W92"
      ]
    },
    "lane": {
