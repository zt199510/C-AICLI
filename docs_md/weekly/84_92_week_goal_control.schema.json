        "lastHandoff"
      ],
      "properties": {
        "state": {
          "enum": [
            "NotStarted",
            "Active",
            "ReadyForIntegration",
            "Integrated",
            "Complete",
            "WaitingUser",
            "Blocked"
          ]
        },
        "head": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/gitSha"
            }
          ]
        },
        "worktree": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "lastHandoff": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "weekState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryGate",
        "exitGate",
        "review",
        "handoffs"
      ],
      "properties": {
        "entryGate": {
          "$ref": "#/$defs/gateStatus"
        },
        "exitGate": {
